{
  "name": "kiosko-ipesa",
  "version": "1.0.0",
  "description": "Kiosko táctil vertical para exhibición de productos",
  "main": "electron/principal.ts",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "build:electron": "npm run build && electron-builder",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint src --ext .vue,.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@blashstar/kiosko-css": "gitlab:blashstar/kiosko-css",
    "@blashstar/visor-360": "github:blashstar/visor-360",
    "electron": "^28.0.0",
    "gsap": "^3.12.2",
    "json5": "^2.2.3",
    "lodash": "^4.17.21",
    "pinia": "^2.1.7",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.202",
    "@vitejs/plugin-vue": "^5.0.0",
    "electron-builder": "^24.9.1",
    "stylus": "^0.63.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-json5": "^1.0.0",
    "vitest": "^1.0.0",
    "vue-tsc": "^1.8.25"
  },
  "build": {
    "appId": "com.ipesa.kiosko",
    "productName": "Kiosko IPESA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable"
    }
  }
}