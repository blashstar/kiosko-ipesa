// ============================================
// Componentes Kiosko (BEM)
// ============================================

@layer componentes
  .kiosko
    &__escena
      width 100%
      height 100%
      display: grid
      place-content: stretch
      place-items: stretch
      position: relative

      &__capa
        grid-area: 1 / 1

        &--fondo
          z-index -1
          display: grid
          place-content: stretch
          place-items: stretch
          position: relative

          img, video
            width 100vw
            height 100vh
            object-fit cover
            min-width: 100%
            min-height: 100%

        &--contenido
          z-index 1
          display: flex
          flex-direction: column
          gap 0
          overflow-y visible

    button, a
    &__boton
      cursor pointer
      user-select none
      touch-action manipulation
      -webkit-tap-highlight-color transparent
      text-decoration: none
      text-align: left
      display: inline-flex

      &--presionado
        background var(--kiosko-color-primario)
        border-color var(--kiosko-color-primario)

      &--deshabilitado
        opacity 0.5
        pointer-events none

    &__titulo
      user-select none
      font-size var(--kiosko-h2-tamano)

    &__texto
      user-select none
      font-size var(--kiosko-body-tamano)
