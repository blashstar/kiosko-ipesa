@import 'kiosko-css/dist/kiosko.css'

// ============================================
// ESTILOS GLOBALES - KIOSKO TÁCTIL IPESA
// ============================================

// ----- Variables -----
$color-fondo = #0a0a0a
$color-texto = #ffffff
$color-acento = #00ff88
$color-secundario = #1a1a1a

// ----- Reset -----
*,
*::before,
*::after
  box-sizing: border-box
  margin: 0
  padding: 0

html,
body
  width: 100%
  height: 100%
  overflow: hidden
  font-family: 'Segoe UI', system-ui, sans-serif
  background: $color-fondo
  color: $color-texto
  -webkit-font-smoothing: antialiased
  -moz-osx-font-smoothing: grayscale

#app
  width: 100%
  height: 100%

// ----- Resolución target -----
html
  font-size: 16px

// ----- Utilidades -----
.pantalla-completa
  width: 100vw
  height: 100vh
  overflow: hidden
  position: relative

.flex-centrado
  display: flex
  justify-content: center
  align-items: center

.transicion-base
  transition: all 0.3s ease

// ----- Animaciones base -----
@keyframes aparece
  from
    opacity: 0
  to
    opacity: 1

@keyframes slide-up
  from
    transform: translateY(20px)
    opacity: 0
  to
    transform: translateY(0)
    opacity: 1