// ============================================
// ESTILOS GLOBALES - Kiosko Táctil IPESA
// Punto de entrada del sistema de diseño
// ============================================

// Sistema de capas: variables, reset, base, componentes y utilidades
@import 'capas/_variables'
@import 'capas/_reset'
@import 'capas/_base'
@import 'capas/_componentes'
@import 'capas/_utilidades'
@import calculos

// Base tipográfica y contenedor raíz
html
  font-size 16px
  -webkit-font-smoothing antialiased
  -moz-osx-font-smoothing grayscale

html,
body
  font-family var(--kiosko-fuente-principal)

#app
  width 100%
  height 100%

// ----- Tooltip informativo del visor 360 -----
.psv-tooltip.info-tooltip
	max-width 500px
	background rgba(42, 42, 42, 0.95)
	border 2px solid #FCB515
	border-radius vh(16px)
	padding vh(16px) vh(24px)
	box-shadow none !important

	&[class*='psv-tooltip--top'] .psv-tooltip-arrow
		border-top-color rgba(42, 42, 42, 0.95)
	&[class*='psv-tooltip--bottom'] .psv-tooltip-arrow
		border-bottom-color rgba(42, 42, 42, 0.95)
	&[class*='psv-tooltip--left'] .psv-tooltip-arrow
		border-left-color rgba(42, 42, 42, 0.95)
	&[class*='psv-tooltip--right'] .psv-tooltip-arrow
		border-right-color rgba(42, 42, 42, 0.95)

	.psv-tooltip-content
		font-size vh(24px)
		line-height 1.4
		color white

		strong
			color #FCB515
			font-size vh(28px)
			display block
			margin-bottom vh(8px)

// ----- Animaciones base reutilizables -----
@keyframes aparece
  from
    opacity 0
  to
    opacity 1

@keyframes slide-up
  from
    transform translateY(20px)
    opacity 0
  to
    transform translateY(0)
    opacity 1


@keyframes levitacion
  0%, 100%
    transform translateY(0)
  50%
    transform translateY(vh(48px))

.grupo
  display flex
  gap vh(16px)
