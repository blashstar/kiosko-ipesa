// ============================================
// Funciones de cálculo responsivo - Kiosko Táctil
// ============================================
//
// Convierte valores en píxeles del diseño base (1080x1920)
// a unidades relativas del viewport para escalado automático.
//
// Uso:
//   padding vh(40)          → 2.083vh
//   width vw(540)           → 50vw
//   font-size rem(16)       → 1rem (base 16px)
//   font-size clamp-rem(14, 16, 18) → clamp(0.875rem, 1rem, 1.125rem)
//
// ============================================

@import './capas/_variables.styl'

// ----- Funciones base de viewport -----

/**
 * Convierte píxeles verticales a vh basado en el alto del kiosko (1920px)
 * @param valor - Píxeles del diseño original
 * @param unidad - Unidad de salida (por defecto "vh")
 * @return Valor convertido con unidad
 */
vh(valor, unidad = 'vh')
  return valor
  // return unit(round((valor / $kioskoAlto) * 100, 3), unidad)

/**
 * Convierte píxeles horizontales a vw basado en el ancho del kiosko (1080px)
 * @param valor - Píxeles del diseño original
 * @param unidad - Unidad de salida (por defecto "vw")
 * @return Valor convertido con unidad
 */
vw(valor, unidad = 'vw')
  return valor
  // return unit(round((valor / $kioskoAncho) * 100, 3), unidad)

// ----- Funciones de viewport mínimo/máximo -----

/**
 * Usa vmin para elementos que deben escalar con la dimensión más pequeña
 * Ideal para iconos, botones táctiles y espaciado proporcional
 */
vmin(valor, unidad = 'vmin')
  $base = $kioskoAncho < $kioskoAlto ? $kioskoAncho : $kioskoAlto
  return unit(round((valor / $base) * 100, 3), unidad)

/**
 * Usa vmax para elementos que deben escalar con la dimensión más grande
 * Ideal para fondos, overlays y elementos decorativos
 */
vmax(valor, unidad = 'vmax')
  $base = $kioskoAncho > $kioskoAlto ? $kioskoAncho : $kioskoAlto
  return unit(round((valor / $base) * 100, 3), unidad)

// ----- Funciones tipográficas -----

/**
 * Convierte píxeles a rem usando la base del HTML (16px por defecto)
 * @param valor - Píxeles del diseño original
 * @param base - Tamaño base en px (por defecto 16)
 */
rem(valor, base = 16)
  return unit(valor / base, 'rem')

/**
 * Genera un clamp() responsivo para tipografía
 * @param min - Tamaño mínimo en px
 * @param preferido - Tamaño ideal en px
 * @param max - Tamaño máximo en px
 * @param base - Tamaño base en px para convertir a rem
 * @return clamp(min-rem, pref-rem, max-rem)
 */
clamp-rem(min, preferido, max, base = 16)
  $min-rem = unit(min / base, 'rem')
  $pref-rem = unit(preferido / base, 'rem')
  $max-rem = unit(max / base, 'rem')
  return 'clamp(%s, %s, %s)' % ($min-rem $pref-rem $max-rem)

/**
 * Genera un clamp() con unidades de viewport para tipografía fluida
 * @param min - Tamaño mínimo en px
 * @param preferido - Píxeles del diseño original (se convierte a vh)
 * @param max - Tamaño máximo en px
 */
clamp-vh(min, preferido, max)
  $min-rem = unit(min / 16, 'rem')
  $pref-vh = vh(preferido)
  $max-rem = unit(max / 16, 'rem')
  return 'clamp(%s, %s, %s)' % ($min-rem $pref-vh $max-rem)

// ----- Funciones de contención -----

/**
 * Limita un valor entre un mínimo y máximo en px
 * Útil para espaciado que no debe crecer indefinidamente
 * @param valor - Píxeles del diseño original
 * @param min - Valor mínimo en px
 * @param max - Valor máximo en px
 */
limitar(valor, min, max)
  $resultado = valor < min ? min : (valor > max ? max : valor)
  return unit($resultado, 'px')

/**
 * Convierte a porcentaje basado en el ancho del kiosko
 * @param valor - Píxeles del diseño original
 */
porcentaje(valor)
  return unit(round((valor / $kioskoAncho) * 100, 2), '%')
